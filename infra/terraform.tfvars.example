# Copy to terraform.tfvars and fill in real values for the target environment
# (sandbox or a specific client's real project). terraform.tfvars is gitignored --
# never commit real org/billing/project IDs.

client_name     = "example-practice"
project_id      = "email-triage-example-practice"
org_id          = "123456789012"
# folder_id     = "" # leave commented/null unless this project lives under a folder
billing_account = "XXXXXX-XXXXXX-XXXXXX"
region          = "us-central1"

# The partner org's existing Access Context Manager policy ID -- a singleton per org,
# created once out of band, shared by every client project's perimeter. Look it up
# with: gcloud access-context-manager policies list --organization=<org_id>
access_policy_id = "111111111111"

# Verify against the live Vertex AI Model Garden for the target region before
# setting this for real -- don't just copy this placeholder.
classifier_model = "gemini-2.5-flash"

# The client's shared mailbox this deployment watches.
mailbox_address = "intake@example-practice.com"
